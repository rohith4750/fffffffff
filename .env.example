# Environment Template for FinFlow Microfinance System

# PostgreSQL Database Connection
# DB Name: finance | Password: newpassword
DATABASE_URL="postgresql://postgres:newpassword@localhost:5432/finance?schema=public"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="demo-finance-hub"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="finance_docs"

# Application Settings
PORT=3000
NODE_ENV="development"
